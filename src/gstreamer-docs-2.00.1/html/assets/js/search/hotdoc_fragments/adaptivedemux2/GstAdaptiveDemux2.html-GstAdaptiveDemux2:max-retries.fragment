fragment_downloaded_cb({"url":"adaptivedemux2/GstAdaptiveDemux2.html#GstAdaptiveDemux2:max-retries","fragment":"\n\tmax-retries\n\nMaximum number of times HTTP request can be retried before considering\nthe request as failed (-1=infinite)\n\n\tFlags :\t\n\t\n\t\t\n\t\t\t\tRead\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tWrite\n\t\t\t\n\n\n\tDefault value :\t3\n\n\n\tSince\t\t\t: 1.26\n\t\t\n"});