fragment_downloaded_cb({"url":"coretracers/leaks.html#GstLeaksTracer::activity-start-tracking","fragment":"\n\tactivity-start-tracking\n\nStart storing information about all objects that are being created or\nremoved. Call stop-tracking to stop.\nNOTE: You do not need to call this to use the *-live-objects action\nsignals listed above.\nParameters:\nthe leaks tracer object to emit this signal on\n\n\tFlags:\t\n\t\n\t\t\n\t\t\t\tRun Last\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tAction\n\t\t\t\n\n\n\tSince\t\t\t: 1.18\n\t\t\n"});