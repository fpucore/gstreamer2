fragment_downloaded_cb({"url":"tensordecoders/yolov8tensordec.html#yolov8tensordec:box-confidence-threshold","fragment":"\n\tbox-confidence-threshold\n\nBoxes with a location confidence level inferior to this threshold will be excluded\n\n\tFlags :\t\n\t\n\t\t\n\t\t\t\tRead\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tWrite\n\t\t\t\n\n\n\tDefault value :\t0.4\n\n"});