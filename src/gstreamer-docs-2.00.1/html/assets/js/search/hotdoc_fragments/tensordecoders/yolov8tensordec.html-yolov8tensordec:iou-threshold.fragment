fragment_downloaded_cb({"url":"tensordecoders/yolov8tensordec.html#yolov8tensordec:iou-threshold","fragment":"\n\tiou-threshold\n\nMaximum intersection-over-union between bounding boxes to consider them distinct.\n\n\tFlags :\t\n\t\n\t\t\n\t\t\t\tRead\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tWrite\n\t\t\t\n\n\n\tDefault value :\t0.7\n\n"});