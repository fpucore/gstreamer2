fragment_downloaded_cb({"url":"closedcaption/index.html#plugin-closedcaption","fragment":"closedcaption\n\n            \n                \n                    Name\n                    Classification\n                    Description\n                \n                    \n                        cc708overlay\n                        Mixer/Video/Overlay/Subtitle\n                        Decode cea608/cea708 data and overlay on proper position of a video buffer\n                    \n                    \n                        cccombiner\n                        Filter\n                        Combines GstVideoCaptionMeta with video input stream\n                    \n                    \n                        ccconverter\n                        Filter/ClosedCaption\n                        Converts Closed Captions between different formats\n                    \n                    \n                        ccextractor\n                        Filter\n                        Extract GstVideoCaptionMeta from input stream\n                    \n                    \n                        cea608mux\n                        Aggregator\n                        Combines raw 608 streams\n                    \n                    \n                        h264ccextractor\n                        Codec/Video/Filter\n                        Extract GstVideoCaptionMeta from input H.264 stream\n                    \n                    \n                        h264ccinserter\n                        Codec/Video/Filter\n                        Insert closed caption data to H.264 streams\n                    \n                    \n                        h265ccextractor\n                        Codec/Video/Filter\n                        Extract GstVideoCaptionMeta from input H.265 stream\n                    \n                    \n                        h265ccinserter\n                        Codec/Video/Filter\n                        Insert closed caption data to H.265 streams\n                    \n                    \n                        line21decoder\n                        Filter/Video/ClosedCaption\n                        Extract line21 CC from SD video streams\n                    \n                    \n                        line21encoder\n                        Filter/Video/ClosedCaption\n                        Inject line21 CC in SD video streams\n                    \n            \n        \n"});