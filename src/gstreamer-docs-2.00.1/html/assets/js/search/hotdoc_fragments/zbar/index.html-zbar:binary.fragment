fragment_downloaded_cb({"url":"zbar/index.html#zbar:binary","fragment":"\n\tbinary\n\nEnable or disable binary QR codes, where binary data is not converted to text.\n\n\tFlags :\t\n\t\n\t\t\n\t\t\t\tRead\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tWrite\n\t\t\t\n\n\n\tDefault value :\tfalse\n\n\n\tSince\t\t\t: 1.26\n\t\t\n"});