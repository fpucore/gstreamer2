fragment_downloaded_cb({"url":"isac/isacenc.html#isacenc:max-payload-size","fragment":"\n\tmax-payload-size\n\nMaximum payload size, in bytes. Range is 120 to 400 at 16 kHz and 120 to 600 at 32 kHz (-1 = encoder default)\n\n\tFlags :\t\n\t\n\t\t\n\t\t\t\tRead\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tWrite\n\t\t\t\n\n\n\tDefault value :\t-1\n\n"});