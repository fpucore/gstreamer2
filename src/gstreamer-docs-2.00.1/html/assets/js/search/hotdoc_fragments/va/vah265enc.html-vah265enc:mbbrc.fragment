fragment_downloaded_cb({"url":"va/vah265enc.html#vah265enc:mbbrc","fragment":"\n\tmbbrc\n\nMacroblock level bitrate control.\nThis is not compatible with Constant QP rate control.\n\n\tFlags :\t\n\t\n\t\t\n\t\t\t\tRead\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tWrite\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tConstruct\n\t\t\t\n\n\n\tDefault value :\tauto (2)\n\n"});