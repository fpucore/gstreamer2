fragment_downloaded_cb({"url":"asio/asiosrc.html#asiosrc:occupy-all-channels","fragment":"\n\toccupy-all-channels\n\nWhen enabled, ASIO device will allocate resources for all in/output channels\n\n\tFlags :\t\n\t\n\t\t\n\t\t\t\tRead\n\t\t\t\n\t\t\t\t/\t\t\n\t\t\t\tWrite\n\t\t\t\n\n\n\tDefault value :\ttrue\n\n"});