fragment_downloaded_cb({"url":"hip/index.html#plugin-hip","fragment":"hip\n\n            \n                \n                    Name\n                    Classification\n                    Description\n                \n                    \n                        hipcompositor\n                        Filter/Editor/Video/Compositor/Hardware\n                        A HIP compositor\n                    \n                    \n                        hipconvert\n                        Filter/Converter/Video/Hardware\n                        Converts video from one colorspace to another using HIP\n                    \n                    \n                        hipconvertscale\n                        Filter/Converter/Video/Scaler/Colorspace/Effect/Hardware\n                        Resizes video and allow color conversion using HIP\n                    \n                    \n                        hipdownload\n                        Filter/Video\n                        Downloads HIP device memory into system memory\n                    \n                    \n                        hipscale\n                        Filter/Converter/Video/Scaler/Hardware\n                        Resize video using HIP\n                    \n                    \n                        hipupload\n                        Filter/Video\n                        Uploads system memory into HIP device memory\n                    \n            \n        \n"});